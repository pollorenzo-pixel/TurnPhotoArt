# Public metadata only; SITE_URL is non-sensitive and optional.
# SITE_URL=https://turnphotoart.example
SITE_INDEXING_ENABLED=false

# Phase 2 fails closed. Both flags must be true for private generation.
TURNPHOTOART_AI_ENABLED=false
TURNPHOTOART_PRIVATE_TEST_ENABLED=false
TURNPHOTOART_GENERATION_PAUSED=true

# Private access. Use long random values; never expose through NEXT_PUBLIC_*.
TURNPHOTOART_TEST_ACCESS_CODE=
TURNPHOTOART_SESSION_SECRET=

# Provider: fake is the safe default. The owner alone may manually change this.
TURNPHOTOART_IMAGE_PROVIDER=fake
TURNPHOTOART_IMAGE_QUALITY=medium
OPENAI_API_KEY=

# Server-only durable state. Raw images are never stored in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conservative Cost Guard limits.
TURNPHOTOART_DAILY_REQUEST_LIMIT=6
TURNPHOTOART_HOURLY_IP_LIMIT=3
TURNPHOTOART_GLOBAL_CONCURRENCY_LIMIT=1
TURNPHOTOART_DAILY_COST_LIMIT_UNITS=1000
TURNPHOTOART_COST_RESERVATION_UNITS_PER_GENERATION=100

# Automated-test-only state adapter. Never use memory state for a real deployment.
# TURNPHOTOART_STATE_PROVIDER=memory
